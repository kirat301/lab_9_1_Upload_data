<Window x:Class="lab_9_1_Upload_data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_9_1_Upload_data"
        mc:Ignorable="d"
        Title="Товары" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        

        <DataGrid x:Name="productDG"
                  FontFamily="Lucida Sans Unicode"
                  Grid.Row="1" 
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Цена, руб." Binding="{Binding Price}" />
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" />
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" />
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Header="Фильтры"
          Grid.Row="0"
          Margin="10,5,10,5"
          Padding="10">

            <StackPanel>
                <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,10">

                    <TextBlock Text="Поиск по названию:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                    <TextBox x:Name="txtSearch"
                     Width="200"
                     Height="27"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>

                    <Button x:Name="btnSearch"
                    Content="Найти"
                    Width="80"
                    Height="27"
                    Click="btnSearch_Click"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <CheckBox x:Name="chkPrice"
                      Content="Фильтр по цене"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"/>

                    <TextBlock Text="От:"
                       VerticalAlignment="Center"/>

                    <TextBox x:Name="txtPriceFrom"
                     Width="75"
                     Height="25"
                     Margin="5,0,10,0"/>

                    <TextBlock Text="До:"
                       VerticalAlignment="Center"/>

                    <TextBox x:Name="txtPriceTo"
                     Width="75"
                     Height="25"
                     Margin="5,0,15,0"/>

                    <TextBlock Text="Категория:"
                       VerticalAlignment="Center"/>

                    <ComboBox x:Name="cmbCategory"
                      Width="150"
                      Height="27"
                      SelectedIndex="0"
                      Margin="5,0,15,0">

                        <ComboBoxItem Content="Все категории"/>

                    </ComboBox>

                    <Button x:Name="btnApplyFilters"
                    Content="Применить фильтр"
                    Height="27"
                    Margin="0,0,5,0"
                    Click="btnApplyFilters_Click"/>

                    <Button x:Name="btnClearFilters"
                    Content="Сбросить фильтр"
                    Height="27"
                    Click="btnClearFilters_Click"/>

                </StackPanel>

            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            Margin="10"
            VerticalAlignment="Center">

            <Button x:Name="btnAdd"
            Content="Добавить"
            Width="90"
            Height="32"
            Margin="0,0,5,0"
            Click="btnAdd_Click"/>

            <Button x:Name="btnEdit"
            Content="Изменить"
            Width="90"
            Height="32"
            Margin="0,0,5,0"
            Click="btnChange_Click"/>

            <Button x:Name="btnDelete"
            Content="Удалить"
            Width="90"
            Height="32"
            Margin="0,0,5,0"
            Click="btnDelete_Click"/>

            <Button x:Name="btnUpdate"
            Content="Обновить"
            Width="100"
            Height="32"
            Margin="0,0,15,0"
            Click="btnUpdate_Click"/>

               <TextBlock x:Name="txtStatus"
               Text="Загружено записей: 0"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="Darkred"
               VerticalAlignment="Center"/>
            
            <Button x:Name="btnReset"
            Content="Сбросить"
            Width="90"
            Height="28"
            Click="btnReset_Click"/>
        </StackPanel>
        
    </Grid>
</Window>