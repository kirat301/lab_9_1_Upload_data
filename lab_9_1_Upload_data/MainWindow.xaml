<Window x:Class="lab_9_1_Upload_data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab_9_1_Upload_data"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="productDG"
                  FontFamily="Lucida Sans Unicode"
                  Grid.Row="0" 
                  ItemsSource="{Binding Products}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" 
                                    Binding="{Binding Code}" />
                <DataGridTextColumn Header="Название" 
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="Цена, руб." 
                                    Binding="{Binding Price}" />
                <DataGridTextColumn Header="Кол-во" 
                                    Binding="{Binding Quantity}" />
                <DataGridTextColumn Header="Категория" 
                                    Binding="{Binding Category}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="btnUpdate"
                Content="Обновить"
                Width="100"
                Height="32"
                Margin="572,326,128,76"
                Click="btnUpdate_Click"/>
        <TextBlock x:Name="txtStatus"
           Text="Загруженно записей: 0"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="Darkred"
           TextWrapping="Wrap"
           TextAlignment="Center"
           Margin="0,326,402,0"/>
    </Grid>
</Window>